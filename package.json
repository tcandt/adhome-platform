{
  "name": "adhome-v2",
  "version": "1.0.0",
  "private": true,
  "description": "AdHome V2 — SaaS Quản lý Căn hộ Dịch vụ Native Monorepo",
  "scripts": {
    "dev:local": "node scripts/dev-local.mjs",
    "dev": "pnpm --filter @adhome/landing dev --host 127.0.0.1 --port 5173",
    "dev:console": "node scripts/dev-console.mjs",
    "dev:console:hot": "node scripts/dev-console.mjs --hot",
    "dev:console:host": "node scripts/dev-console.mjs",
    "dev:landing": "pnpm --filter @adhome/landing dev --host 127.0.0.1 --port 5173",
    "dev:api": "pnpm --filter @adhome/api dev",
    "build": "pnpm -r build",
    "build:landing": "pnpm --filter @adhome/landing build",
    "build:console": "pnpm --filter @adhome/console build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "build:worker": "pnpm --filter @adhome/landing build:worker",
    "build:console:worker": "pnpm --filter @adhome/console build",
    "deploy:console:worker": "pnpm run build:console:worker && npx wrangler deploy --config wrangler.console.jsonc",
    "deploy:worker": "pnpm run build:worker && npx wrangler deploy"
  },
  "packageManager": "pnpm@11.14.0",
  "devDependencies": {
    "oxlint": "^1.90.0",
    "playwright": "^1.64.1"
  }
}
