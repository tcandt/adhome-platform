generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id             String   @id
  slug           String   @unique
  name           String
  hotline        String
  addressSummary String   @map("address_summary")
  isActive       Boolean  @default(true) @map("is_active")
  catalogVersion Int      @default(1) @map("catalog_version")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  buildings Building[]
  floors    Floor[]
  rooms     PublicRoomListing[]

  @@map("organizations")
}

model Building {
  id            String   @id
  orgId         String   @map("org_id")
  code          String
  name          String
  streetAddress String   @map("street_address")
  ward          String
  province      String
  displayOrder  Int      @default(1) @map("display_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  floors       Floor[]
  rooms        PublicRoomListing[]

  @@unique([orgId, code])
  @@index([orgId, isActive, displayOrder])
  @@map("buildings")
}

model Floor {
  id          String   @id
  orgId       String   @map("org_id")
  buildingId  String   @map("building_id")
  floorNumber Int      @map("floor_number")
  name        String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  building     Building            @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  rooms        PublicRoomListing[]

  @@unique([buildingId, floorNumber])
  @@index([orgId, buildingId])
  @@map("floors")
}

model PublicRoomListing {
  id                  String   @id
  orgId               String   @default("org-adhome-anphu") @map("org_id")
  buildingId          String   @map("building_id")
  floorId             String?  @map("floor_id")
  slug                String   @unique
  previousSlugs       Json     @default("[]") @map("previous_slugs")
  roomCode            String   @map("room_code")
  shortTitle          String   @map("short_title")
  title               String
  roomType            String   @map("room_type")
  buildingCode        String   @map("building_code")
  buildingName        String   @map("building_name")
  buildingAddress     String   @map("building_address")
  floorNumber         Int      @map("floor_number")
  floorName           String   @map("floor_name")
  area                Float
  price               Int
  currency            String   @default("VND")
  depositMonths       Int      @default(1) @map("deposit_months")
  maxOccupants        String   @map("max_occupants")
  status              String
  availableFrom       String   @map("available_from")
  availableFromLabel  String   @map("available_from_label")
  shortDescription    String   @map("short_description")
  detailedDescription String   @map("detailed_description")
  amenities           Json
  furnishedLevel      String   @map("furnished_level")
  furnishedLabel      String   @map("furnished_label")
  images              Json
  serviceFees         Json     @map("service_fees")
  featured            Boolean  @default(false)
  displayOrder        Int      @default(1) @map("display_order")
  isPublic            Boolean  @default(true) @map("is_public")
  sourceVerified      Boolean  @default(true) @map("source_verified")
  currentTenantName   String?  @map("current_tenant_name")
  currentTenantPhone  String?  @map("current_tenant_phone")
  internalNotes       String?  @map("internal_notes")
  version             Int      @default(1)
  updatedAt           DateTime @updatedAt @map("updated_at")
  createdAt           DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  building     Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  floor        Floor?       @relation(fields: [floorId], references: [id], onDelete: SetNull)

  @@index([orgId, buildingId])
  @@index([isPublic, status, displayOrder])
  @@map("public_room_listings")
}

model LeadInquiry {
  id                         String   @id @default(uuid())
  referenceCode              String   @unique @map("reference_code")
  orgId                      String   @default("org-adhome-anphu") @map("org_id")
  roomId                     String?  @map("room_id")
  roomSlug                   String?  @map("room_slug")
  roomCode                   String?  @map("room_code")
  roomTitle                  String?  @map("room_title")
  fullName                   String   @map("full_name")
  phone                      String
  normalizedPhone            String   @map("normalized_phone")
  inquiryType                String   @map("inquiry_type")
  preferredMoveInDate        String?  @map("preferred_move_in_date")
  preferredMoveInDateDisplay String?  @map("preferred_move_in_date_display")
  note                       String?
  privacyConsent             Boolean  @map("privacy_consent")
  status                     String   @default("NEW")
  dedupeWindowKey            String   @unique @map("dedupe_window_key")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  @@index([orgId, createdAt])
  @@index([normalizedPhone, createdAt])
  @@index([roomId, createdAt])
  @@map("lead_inquiries")
}

model RoomAuditLog {
  id             String   @id @default(uuid())
  orgId          String   @map("org_id")
  buildingId     String   @map("building_id")
  roomId         String   @map("room_id")
  roomSlug       String   @map("room_slug")
  actorUserId    String   @map("actor_user_id")
  actorRole      String   @map("actor_role")
  action         String
  changedFields  Json     @map("changed_fields")
  previousValues Json     @map("previous_values")
  newValues      Json     @map("new_values")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([orgId, roomId, createdAt])
  @@map("room_audit_logs")
}

model ConsoleActor {
  id             String   @id
  email          String   @unique
  displayName    String?  @map("display_name")
  orgId          String   @map("org_id")
  role           String
  permissions    Json
  buildingScopes Json     @map("building_scopes")
  sessionVersion Int      @default(1) @map("session_version")
  isActive       Boolean  @default(true) @map("is_active")
  /// Per-account scrypt hash (format: scrypt$N$r$p$salt$hash). NULL = login impossible.
  passwordHash      String?   @map("password_hash")
  passwordUpdatedAt DateTime? @map("password_updated_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([orgId, isActive])
  @@map("console_actors")
}

/// Append-only audit trail of every Console login attempt (success and failure).
model ConsoleLoginAudit {
  id             String   @id @default(uuid())
  actorId        String?  @map("actor_id")
  emailAttempted String   @map("email_attempted")
  outcome        String
  clientIp       String   @map("client_ip")
  jti            String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("console_login_audit")
}

model RevokedToken {
  jti       String   @id
  actorId   String   @map("actor_id")
  reason    String
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime @default(now()) @map("revoked_at")

  @@index([actorId])
  @@map("revoked_tokens")
}

model SeoSyncJob {
  id            String    @id @default(uuid())
  orgId         String    @map("org_id")
  roomId        String    @map("room_id")
  roomSlug      String    @map("room_slug")
  previousSlug  String?   @map("previous_slug")
  triggerAction String    @map("trigger_action")
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  maxAttempts   Int       @default(3) @map("max_attempts")
  lastError     String?   @map("last_error")
  catalogVer    Int       @default(1) @map("catalog_ver")
  syncedAt      DateTime? @map("synced_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([roomId, createdAt])
  @@map("seo_sync_jobs")
}
